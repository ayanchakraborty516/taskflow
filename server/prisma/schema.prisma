datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum WorkspaceRole {
  Owner
  Admin
  Member
  Viewer
}

enum ProjectStatus {
  planning
  in_progress
  completed
  archived
}

enum TaskStatus {
  todo
  in_progress
  in_review
  done
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

enum NotificationType {
  task_assigned
  task_status
  comment_added
  project_update
  system
}

// -----------------------------------------------------------------------------
// 1. User
// -----------------------------------------------------------------------------

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String
  password           String
  avatar             String   @default("")
  jobTitle           String   @default("Product Contributor") @map("job_title")
  isActive           Boolean  @default(true) @map("is_active")
  currentWorkspaceId String?  @map("current_workspace_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relations
  currentWorkspace      Workspace?        @relation("UserCurrentWorkspace", fields: [currentWorkspaceId], references: [id], onDelete: SetNull)
  ownedWorkspaces       Workspace[]       @relation("WorkspaceOwner")
  workspaceMemberships  WorkspaceMember[]
  projectMemberships    ProjectMember[]
  refreshTokens         RefreshToken[]
  ledProjects           Project[]         @relation("ProjectLead")
  createdTasks          Task[]            @relation("TaskCreator")
  assignedTasks         Task[]            @relation("TaskAssignee")
  comments              Comment[]
  activities            Activity[]
  receivedNotifications Notification[]    @relation("NotificationRecipient")
  sentNotifications     Notification[]    @relation("NotificationSender")

  @@index([email])
  @@map("users")
}

// -----------------------------------------------------------------------------
// 2. Workspace
// -----------------------------------------------------------------------------

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @default("")
  ownerId     String   @map("owner_id")
  inviteCode  String   @unique @default(cuid()) @map("invite_code")
  color       String   @default("#5757d9")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  owner         User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members       WorkspaceMember[]
  projects      Project[]
  tasks         Task[]
  comments      Comment[]
  activities    Activity[]
  notifications Notification[]
  currentUsers  User[]            @relation("UserCurrentWorkspace")

  @@index([slug])
  @@index([ownerId])
  @@map("workspaces")
}

// -----------------------------------------------------------------------------
// 3. WorkspaceMember (Tenant Roster & Composite Reference Hub)
// -----------------------------------------------------------------------------

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole @default(Member)
  joinedAt    DateTime      @default(now()) @map("joined_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  // Direct Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Composite foreign key back-relations (ensures tenant boundary integrity)
  ledProjects           Project[]       @relation("ProjectLeadMember")
  assignedTasks         Task[]          @relation("TaskAssigneeMember")
  createdTasks          Task[]          @relation("TaskCreatorMember")
  authoredComments      Comment[]       @relation("CommentAuthorMember")
  receivedNotifications Notification[]  @relation("NotificationRecipientMember")
  sentNotifications     Notification[]  @relation("NotificationSenderMember")
  projectMemberships    ProjectMember[] @relation("ProjectMemberWorkspaceMember")

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role])
  @@map("workspace_members")
}

// -----------------------------------------------------------------------------
// 4. Project
// -----------------------------------------------------------------------------

model Project {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  name        String
  key         String
  description String        @default("")
  category    String        @default("Design & Eng")
  status      ProjectStatus @default(in_progress)
  color       String        @default("#5757d9")
  icon        String        @default("folder")
  leadId      String?       @map("lead_id")
  startDate   DateTime      @default(now()) @map("start_date")
  targetDate  DateTime?     @map("target_date")
  isStarred   Boolean       @default(false) @map("is_starred")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  // Direct relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      User?     @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)

  // Composite foreign-key constraint enforcing that the project lead MUST be a member of this workspace
  leadMember WorkspaceMember? @relation("ProjectLeadMember", fields: [workspaceId, leadId], references: [workspaceId, userId], onDelete: NoAction)

  // Sub-entities
  tasks      Task[]
  members    ProjectMember[]
  activities Activity[]

  // Composite unique constraints
  @@unique([workspaceId, key])
  @@unique([workspaceId, id])
  @@index([workspaceId, status])
  @@index([leadId])
  @@map("projects")
}

// -----------------------------------------------------------------------------
// 4b. ProjectMember (Project Roster & Workspace-Isolated Membership)
// -----------------------------------------------------------------------------

model ProjectMember {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  projectId   String   @map("project_id")
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  // Direct relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Composite foreign keys enforcing strict workspace tenant boundary
  project         Project         @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade)
  workspaceMember WorkspaceMember @relation("ProjectMemberWorkspaceMember", fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([workspaceId, userId])
  @@index([userId])
  @@map("project_members")
}

// -----------------------------------------------------------------------------
// 5. Task
// -----------------------------------------------------------------------------

model Task {
  id          String       @id @default(cuid())
  workspaceId String       @map("workspace_id")
  projectId   String       @map("project_id")
  title       String
  description String       @default("")
  key         String?
  status      TaskStatus   @default(todo)
  priority    TaskPriority @default(medium)
  assigneeId  String?      @map("assignee_id")
  creatorId   String       @map("creator_id")
  dueDate     DateTime?    @map("due_date")
  labels      String[]     @default([])
  order       Int          @default(0)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  // Direct relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator   User      @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  assignee  User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  // Composite tenant foreign key: guarantees task's project belongs to the SAME workspace
  project Project @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade)

  // Composite tenant foreign key: guarantees assignee and creator are members of the SAME workspace
  assigneeMember WorkspaceMember? @relation("TaskAssigneeMember", fields: [workspaceId, assigneeId], references: [workspaceId, userId], onDelete: NoAction)
  creatorMember  WorkspaceMember  @relation("TaskCreatorMember", fields: [workspaceId, creatorId], references: [workspaceId, userId], onDelete: Restrict)

  // Sub-entities
  subtasks   Subtask[]
  comments   Comment[]
  activities Activity[]

  // Composite unique constraints & indexes
  @@unique([workspaceId, id])
  @@unique([projectId, key])
  @@index([workspaceId, projectId, status, order])
  @@index([workspaceId, assigneeId])
  @@index([workspaceId, dueDate])
  @@index([creatorId])
  @@map("tasks")
}

// -----------------------------------------------------------------------------
// 5b. Subtask
// -----------------------------------------------------------------------------

model Subtask {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  taskId      String   @map("task_id")
  title       String
  completed   Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Composite tenant foreign key: guarantees subtask belongs to a task in the SAME workspace
  task Task @relation(fields: [workspaceId, taskId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, taskId])
  @@index([taskId])
  @@map("subtasks")
}

// -----------------------------------------------------------------------------
// 6. Comment
// -----------------------------------------------------------------------------

model Comment {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  taskId      String   @map("task_id")
  authorId    String   @map("author_id")
  content     String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Composite tenant foreign key: guarantees comment belongs to a task in the SAME workspace
  task Task @relation(fields: [workspaceId, taskId], references: [workspaceId, id], onDelete: Cascade)

  // Composite tenant foreign key: guarantees comment author is a member of the SAME workspace
  authorMember WorkspaceMember @relation("CommentAuthorMember", fields: [workspaceId, authorId], references: [workspaceId, userId], onDelete: Cascade)

  @@index([workspaceId, taskId])
  @@index([authorId])
  @@map("comments")
}

// -----------------------------------------------------------------------------
// 7. Activity
// -----------------------------------------------------------------------------

model Activity {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  projectId   String?  @map("project_id")
  taskId      String?  @map("task_id")
  userId      String   @map("user_id")
  action      String
  details     String
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([userId])
  @@index([projectId])
  @@index([taskId])
  @@map("activities")
}

// -----------------------------------------------------------------------------
// 8. Notification
// -----------------------------------------------------------------------------

model Notification {
  id          String           @id @default(cuid())
  workspaceId String           @map("workspace_id")
  recipientId String           @map("recipient_id")
  senderId    String?          @map("sender_id")
  type        NotificationType @default(system)
  title       String
  message     String
  link        String           @default("")
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipient User      @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  sender    User?     @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)

  // Composite tenant foreign key: recipient must be a member of this workspace
  recipientMember WorkspaceMember  @relation("NotificationRecipientMember", fields: [workspaceId, recipientId], references: [workspaceId, userId], onDelete: Cascade)
  senderMember    WorkspaceMember? @relation("NotificationSenderMember", fields: [workspaceId, senderId], references: [workspaceId, userId], onDelete: NoAction)

  @@index([recipientId, read, createdAt(sort: Desc)])
  @@index([workspaceId, recipientId])
  @@map("notifications")
}

// -----------------------------------------------------------------------------
// 9. RefreshToken (Authentication Session Management)
// -----------------------------------------------------------------------------

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

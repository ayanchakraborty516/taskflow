# TaskFlow Server Environment Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/taskflow?schema=public

# Authentication & Security Secrets
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_signing_secret_here
COOKIE_SAMESITE=lax

# Allowed Frontend Origins (comma-separated for multiples)
CLIENT_URL=http://localhost:5173


# TaskFlow Root Environment Configuration Template
# Server Environment Variables (for server/.env or Render Dashboard)
PORT=5000
NODE_ENV=development

# MongoDB Atlas or Local connection URI (database name: taskflow)
# Atlas Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/taskflow?retryWrites=true&w=majority
# Local Format: mongodb://127.0.0.1:27017/taskflow
MONGODB_URI=mongodb://127.0.0.1:27017/taskflow
DB_NAME=taskflow

# Security & Authentication Secrets
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_signing_secret_here

# Cookie SameSite setting ('lax' for local, 'none' for Render + Vercel cross-domain)
COOKIE_SAMESITE=lax

# Allowed Frontend Origins (comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173

# Client Environment Variables (for client/.env or Vercel Dashboard)
# For local development with Vite proxy: /api
# For production on Vercel: https://<your-render-service>.onrender.com/api
VITE_API_URL=/api


{
  "name": "taskflow",
  "version": "1.0.0",
  "description": "TaskFlow - Modern Project Management Web Application (MERN)",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "node -e \"console.log('Use npm run dev:server and npm run dev:client, or npm start')\"",
    "start": "npm run start --workspace=server",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build:client": "npm run build --workspace=client",
    "build": "npm run build:client",
    "test:server": "npm test --workspace=server",
    "test:client": "npm test --workspace=client",
    "test": "npm run test:server && npm run test:client",
    "seed": "npm run seed --workspace=server"
  },
  "keywords": [
    "taskflow",
    "mern",
    "project-management",
    "kanban"
  ],
  "author": "TaskFlow Team",
  "license": "ISC"
}
